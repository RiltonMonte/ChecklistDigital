<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permite salvar imagens no cache interno -->
    <cache-path
        name="images"
        path="." />

    <!-- Se quiser salvar em diretório externo específico -->
    <external-path
        name="external_images"
        path="Pictures/" />
</paths>
